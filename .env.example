# Copy to .env and adjust.

# "local" for Ollama (or any OpenAI-compatible server),
# "gemini" for Google AI Studio (free key), "remote" for OpenAI
AI_BACKEND=local
API_KEY=

# Optional, each backend has its own defaults
# BASE_URL=http://localhost:11434/v1/
# CHAT_MODEL=gemma3:latest
# EMBEDDING_MODEL=nomic-embed-text

# Folder that is indexed by default
WATCHED_DIR=.

# Optional
# TOP_K=5
# CHUNK_LINES=60
# CHUNK_OVERLAP=10
# CODERAG_CACHE_DIR=~/.cache/coderag
