# Copy to .env and adjust.

# "local" for Ollama (or any OpenAI-compatible server), "remote" for OpenAI
AI_BACKEND=local
BASE_URL=http://localhost:11434/v1/
API_KEY=

# Models (Ollama names shown, for OpenAI use e.g. gpt-4o-mini and text-embedding-3-small)
CHAT_MODEL=gemma3:latest
EMBEDDING_MODEL=nomic-embed-text

# Folder that is indexed by default
WATCHED_DIR=.

# Optional
# TOP_K=5
# CHUNK_LINES=60
# CHUNK_OVERLAP=10
# CODERAG_CACHE_DIR=~/.cache/coderag
